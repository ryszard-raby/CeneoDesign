{
  "schemaVersion": 1,
  "name": "Card",
  "description": "Flexible content surface with white, gray, outlined and bottom-border styles.",
  "example": "<div class=\"cd-card cd-card--white\">...</div>",
  "stylePath": "components/card/card.css",
  "classes": [
    "cd-card",
    "cd-card--white",
    "cd-card--outlined",
    "cd-card--border-bottom",
    "cd-card--gray"
  ],
  "variants": {
    "cardStyle": {
      "values": [
        "white",
        "outlined",
        "border-bottom",
        "gray"
      ],
      "classPattern": "cd-card--{value}",
      "default": "white"
    }
  }
}
