{
  "schemaVersion": 1,
  "name": "Label",
  "description": "Compact primary-colored label with filled and plain variants and an optional leading icon.",
  "example": "<span class=\"cd-label cd-label--filled\"><span class=\"cd-label__text\">Label</span></span>",
  "stylePath": "components/label/label.css",
  "classes": [
    "cd-label",
    "cd-label__icon",
    "cd-label__text",
    "cd-label--filled",
    "cd-label--plain"
  ],
  "variants": {
    "variant": {
      "values": [
        "filled",
        "plain"
      ],
      "classPattern": "cd-label--{value}",
      "default": "filled"
    }
  }
}
