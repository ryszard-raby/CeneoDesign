{
  "schemaVersion": 1,
  "name": "Text",
  "description": "Responsive text primitive with seven token-based sizes, two weights and configurable semantic markup.",
  "example": "<span class=\"cd-text cd-text--xs cd-text--normal\">Text</span>",
  "stylePath": "components/text/text.css",
  "classes": [
    "cd-text",
    "cd-text--xs",
    "cd-text--sm",
    "cd-text--base",
    "cd-text--lg",
    "cd-text--xl",
    "cd-text--2xl",
    "cd-text--3xl",
    "cd-text--normal",
    "cd-text--bold"
  ],
  "variants": {
    "size": {
      "values": [
        "xs",
        "sm",
        "base",
        "lg",
        "xl",
        "2xl",
        "3xl"
      ],
      "classPattern": "cd-text--{value}",
      "default": "xs"
    },
    "weight": {
      "values": [
        "normal",
        "bold"
      ],
      "classPattern": "cd-text--{value}",
      "default": "normal"
    }
  },
  "attributes": [
    {
      "name": "as",
      "values": [
        "span",
        "p",
        "div",
        "label",
        "strong",
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ],
      "default": "span"
    }
  ]
}
