{
  "schemaVersion": 1,
  "name": "Price",
  "description": "Product price composed of an optional prefix, emphasized amount, decimal part and currency.",
  "example": "<span class=\"cd-price\"><span class=\"cd-price__prefix\">od</span><span class=\"cd-price__amount\">2 400</span><span class=\"cd-price__suffix\">,00 zł</span></span>",
  "stylePath": "components/price/price.css",
  "classes": [
    "cd-price",
    "cd-price__prefix",
    "cd-price__amount",
    "cd-price__suffix"
  ],
  "variants": {},
  "attributes": [
    {
      "name": "amount",
      "type": "number | string",
      "default": 2400
    },
    {
      "name": "decimal",
      "type": "string",
      "default": "00"
    },
    {
      "name": "currency",
      "type": "string",
      "default": "zł"
    },
    {
      "name": "prefix",
      "type": "string",
      "default": "od"
    },
    {
      "name": "showPrefix",
      "type": "boolean",
      "default": true
    }
  ]
}
