{
  "schemaVersion": 1,
  "name": "Container",
  "description": "Full-width flex container that lays out content horizontally with wrapping or vertically.",
  "example": "<div class=\"cd-container cd-container--horizontal\">...</div>",
  "stylePath": "components/container/container.css",
  "classes": [
    "cd-container",
    "cd-container--horizontal",
    "cd-container--vertical"
  ],
  "variants": {
    "direction": {
      "values": [
        "horizontal",
        "vertical"
      ],
      "classPattern": "cd-container--{value}",
      "default": "horizontal"
    }
  }
}
