{
  "schemaVersion": 1,
  "name": "Button",
  "description": "Action control with seven visual variants, two sizes and optional leading or trailing icons.",
  "example": "<button type=\"button\" class=\"cd-button cd-button--primary cd-button--default\"><span class=\"cd-button__label\">Button</span></button>",
  "stylePath": "components/button/button.css",
  "classes": [
    "cd-button",
    "cd-button__icon",
    "cd-button__label",
    "cd-button--primary",
    "cd-button--accent",
    "cd-button--outline",
    "cd-button--selected",
    "cd-button--dashed",
    "cd-button--blank",
    "cd-button--gray",
    "cd-button--default",
    "cd-button--small"
  ],
  "variants": {
    "variant": {
      "values": [
        "primary",
        "accent",
        "outline",
        "selected",
        "dashed",
        "blank",
        "gray"
      ],
      "classPattern": "cd-button--{value}",
      "default": "primary"
    },
    "size": {
      "values": [
        "default",
        "small"
      ],
      "classPattern": "cd-button--{value}",
      "default": "default"
    }
  }
}
