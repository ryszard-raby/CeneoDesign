{
  "schemaVersion": 1,
  "name": "Rating",
  "description": "Product rating with stars, numeric score and review count in default, small and compact variants.",
  "example": "<span class=\"cd-rating cd-rating--default\">...</span>",
  "stylePath": "components/rating/rating.css",
  "classes": [
    "cd-rating",
    "cd-rating__stars",
    "cd-rating__star",
    "cd-rating__value",
    "cd-rating__count",
    "cd-rating--default",
    "cd-rating--small",
    "cd-rating--compact"
  ],
  "variants": {
    "size": {
      "values": [
        "default",
        "small",
        "compact"
      ],
      "classPattern": "cd-rating--{value}",
      "default": "default"
    }
  },
  "attributes": [
    {
      "name": "value",
      "type": "number",
      "default": 4.5
    },
    {
      "name": "count",
      "type": "number",
      "default": 999
    }
  ]
}
