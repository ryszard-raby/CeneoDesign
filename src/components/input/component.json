{
  "schemaVersion": 1,
  "name": "Input",
  "description": "Native single-line text field with Ceneo typography, border and radius tokens.",
  "example": "<input type=\"text\" class=\"cd-input\" placeholder=\"Placeholder\" />",
  "stylePath": "components/input/input.css",
  "classes": [
    "cd-input"
  ],
  "variants": {},
  "attributes": [
    {
      "name": "type",
      "type": "native input type",
      "default": "text"
    },
    {
      "name": "placeholder",
      "type": "string",
      "default": "Placeholder"
    },
    {
      "name": "value",
      "type": "native input value"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false
    }
  ]
}
